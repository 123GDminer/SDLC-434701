@startuml
' Электронный путеводитель. Варианты использования и отношения между ними.
left to right direction
actor "Читатель" as Reader
actor "Автор" as Author
rectangle "Электронный путеводитель" {
 usecase "Посмотреть каталог страны" as Catalog
 usecase "Отфильтровать по времени" as Filter
 usecase "Открыть маршрут" as Route
 usecase "Показать остановки" as Stops
 usecase "Открыть обзор по ссылке" as Open
 usecase "Опубликовать отзыв" as Publish
 usecase "Прикрепить фотографии" as Photos
 usecase "Поделиться ссылкой" as Share
}
Reader -- Catalog
Reader -- Route
Reader -- Open
Author -- Publish
Author -- Share
Filter ..> Catalog : <<extend>>
Route ..> Stops : <<include>>
Photos ..> Publish : <<extend>>
@enduml
